# Copy this file to `.env` and fill in the values. NEVER commit `.env`.

# Sepolia RPC endpoint (Alchemy / Infura / any public Sepolia RPC)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Private key of the PLATFORM / ARBITER test account (MetaMask "Account 3").
# This account deploys the contract and becomes the arbiter.
# Use a dedicated throw-away test account that holds only Sepolia test ETH.
DEPLOYER_PRIVATE_KEY=0xYOUR_TEST_ACCOUNT_PRIVATE_KEY

# Optional: only needed for `npx hardhat verify`
ETHERSCAN_API_KEY=
