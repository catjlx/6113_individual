# Copy this file to backend/.env. It is separate from the repository-root .env on purpose:
# the backend only needs a read-only RPC URL and must never see a private key.

# Which deployment to serve: "sepolia" or "localhost" (reads deployments/<NETWORK>.json)
NETWORK=sepolia

# Sepolia RPC endpoint (Alchemy / Infura / public RPC). For NETWORK=localhost this defaults to
# http://127.0.0.1:8545 and can be left empty.
RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Optional
# PORT=3000
# POLL_INTERVAL_MS=8000
# CONFIRMATIONS=0
# LOG_CHUNK=500      # lower this (e.g. 10) if your RPC provider limits eth_getLogs ranges
